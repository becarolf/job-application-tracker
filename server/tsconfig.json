{
  "compilerOptions": {
    "target": "ES2022",
    // tells TypeScript to compile using modern Node module behavior
    "module": "NodeNext",
    // tells TypeScript how to find imported packages like express, cors, dotenv
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}